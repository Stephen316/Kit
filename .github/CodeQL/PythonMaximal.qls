---
- description: Parashell maximal Python security and quality queries
- apply: codeql-suites/python-security-and-quality.qls
  from: codeql/python-queries
- apply: codeql-suites/python-security-experimental.qls
  from: codeql/python-queries
- query: AlertSuppression.ql
  from: codeql/python-queries
- exclude:
    id:
      - py/not-named-self
      - py/not-named-cls
      - py/possible-timing-attack-sensitive-info
      - py/possible-timing-attack-against-hash
