solid owned_open_repair_tetra
  facet normal 0 0 -1
    outer loop
      vertex 0 0 0
      vertex 0 3 0
      vertex 2 0 0
    endloop
  endfacet
  facet normal 0 -1 0
    outer loop
      vertex 0 0 0
      vertex 2 0 0
      vertex 0 0 4
    endloop
  endfacet
  facet normal -1 0 0
    outer loop
      vertex 0 0 0
      vertex 0 0 4
      vertex 0 3 0
    endloop
  endfacet
endsolid owned_open_repair_tetra
